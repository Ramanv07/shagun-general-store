{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_URL": "/api"
    }
  },
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "regions": ["bom1"]
    }
  },
  "redirects": [
    {
      "source": "/shagun-app.apk",
      "destination": "https://expo.dev/artifacts/eas/b_4wni3cACTyls5rJnrSSAh-knS2uBqnd2wrwILdEzU.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://shagunmart-29a7d.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|.*\\.apk$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/categories/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/products(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
