# ─── Copy this file to .env and fill in your values ───────────────

# ── Frontend (Vite) ──────────────────────────────────────────────
# Leave blank on Vercel — same-origin /api is used automatically
# Set to http://localhost:5000 only for local dev (optional, proxy handles it)
VITE_API_URL=

# ── Backend (Vercel Environment Variables) ────────────────────────
# Add these in: Vercel Dashboard → Project Settings → Environment Variables

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS) — your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app

# Public Site URL for SEO / Canonical (e.g. https://shagun-general-store.vercel.app)
VITE_SITE_URL=https://your-app.vercel.app

# ── OTP & Email Delivery ─────────────────────────────────────────────
OTP_CHANNEL=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM_NAME="Shagun Mart"
