# ─── Environment Template (Safe defaults for local staging & dev) ─────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────
# Local staging database (default for development; never points to Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/shagun-staging
STAGING_MONGODB_URI=mongodb://127.0.0.1:27017/shagun-staging

# ── Authentication & Security ─────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_in_production
FRONTEND_URL=http://localhost:5173

# ── Media Uploads (Cloudinary) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Communications & Alerts ───────────────────────────────────────────
ADMIN_WHATSAPP=918827259023
NTFY_TOPIC=shagun-mart-orders-dev
CALLMEBOT_API_KEY=

# ── Frontend & Native App API Configuration ──────────────────────────
# Web API base URL (Vite frontend)
VITE_API_URL=http://localhost:5000/api

# Mobile App API base URL (Expo Native App; use LAN IP e.g. http://192.168.1.X:5000/api for real phone)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

OTP_CHANNEL=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
MAIL_FROM_NAME="Shagun Mart"
